# Copy this file to .env.backend on the DuckDNS backend host.
# Never commit the real .env.backend file.

ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/seo
SECRET_KEY=replace-with-a-long-random-production-secret

# Set these to the real frontend/API hosts used in Production.
CORS_ORIGINS=https://YOUR-PRODUCTION-FRONTEND.example
ALLOWED_HOSTS=sistemaeficienciaoperacional.duckdns.org,127.0.0.1,localhost

# Agent Manager can execute the approved billing workflow.
AGENT_MANAGER_ENABLED=true

# Keep sensitive/general write execution disabled until separately approved.
AGENT_EXECUTION_ENABLED=false
SNC_INTEGRATION_ENABLED=false
SNC_WRITE_ENABLED=false
SAFT_INTEGRATION_ENABLED=false

# Artifact storage is also pinned by docker-compose.backend.yml.
SEO_ARTIFACT_STORAGE_PROVIDER=local
SEO_ARTIFACT_STORAGE_PATH=/var/lib/seo/agent-storage
SEO_MAX_UPLOAD_BYTES=10485760

LOG_LEVEL=INFO
