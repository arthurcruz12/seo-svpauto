SEO_SMTP_USERNAME=
SEO_SMTP_PASSWORD=
SEO_SMTP_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=seo-documentos
AZURE_BACKUP_CONTAINER=seo-backups
