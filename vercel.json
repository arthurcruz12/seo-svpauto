{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "installCommand": "echo legacy-frontend-recovery",
  "buildCommand": "rm -rf dist && mkdir -p dist && python scripts/fetch-legacy-assets.py && cp legacy/index.html dist/index.html",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/seo-api/:path*",
      "destination": "https://sistemaeficienciaoperacional.duckdns.org/:path*"
    },
    {
      "source": "/((?!api/|seo-api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
