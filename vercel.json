{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "installCommand": "echo legacy-frontend",
  "buildCommand": "mkdir -p dist && cp legacy/index.html dist/index.html",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/seo-api/:path*",
      "destination": "https://sistemaeficienciaoperacional.duckdns.org/:path*"
    },
    {
      "source": "/((?!api/|seo-api/).*)",
      "destination": "/index.html"
    }
  ]
}
