{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "installCommand": "echo protection-read-diagnostic",
  "buildCommand": "vercel project protection seo-svpauto --format json; exit 1",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/seo-api/:path*",
      "destination": "https://sistemaeficienciaoperacional.duckdns.org/:path*"
    },
    {
      "source": "/((?!api/|seo-api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
