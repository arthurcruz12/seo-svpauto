{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "installCommand": "echo legacy-frontend",
  "buildCommand": "rm -rf dist && mkdir -p dist/assets && cp legacy/index.html dist/index.html && cp legacy/assets/* dist/assets/",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/seo-api/:path*",
      "destination": "https://sistemaeficienciaoperacional.duckdns.org/:path*"
    },
    {
      "source": "/((?!api/|seo-api/).*)",
      "destination": "/index.html"
    }
  ]
}
